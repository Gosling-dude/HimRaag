rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ──────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isArtist() {
      return isSignedIn() && request.auth.token.role == 'artist';
    }

    // ─── Songs ─────────────────────────────────────────────────────────────────
    // Public music catalog — all songs readable without authentication.
    // Firestore range queries (prefix search) on titleLowercase require the
    // collection to be publicly readable; filtering by isApproved is done in
    // app code. isApproved field is still enforced at write-time by admin check.

    match /songs/{songId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── Albums ────────────────────────────────────────────────────────────────

    match /albums/{albumId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── Artists ───────────────────────────────────────────────────────────────

    // An artist with the `role: artist` claim may update (not create/delete)
    // the profile doc they own. Ownership is fixed: ownerUid cannot be changed,
    // and moderation fields (approvalStatus, isPublished, isVerified) stay
    // admin-only even on self-update.
    match /artists/{artistId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isArtist()
            && resource.data.ownerUid == request.auth.uid
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.approvalStatus == resource.data.approvalStatus
            && request.resource.data.isPublished == resource.data.isPublished
            && request.resource.data.isVerified == resource.data.isVerified);
    }

    // ─── Playlists ─────────────────────────────────────────────────────────────

    match /playlists/{playlistId} {
      allow read: if resource.data.isPublic == true;
      allow read: if isOwner(resource.data.ownerId);
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.ownerId;
      allow update, delete: if isOwner(resource.data.ownerId);
      allow create, update, delete: if isAdmin();
    }

    // ─── Users ─────────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read, write: if isOwner(userId);
      allow read: if isAdmin();
    }

    // ─── Categories ────────────────────────────────────────────────────────────

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── Regions ───────────────────────────────────────────────────────────────

    match /regions/{regionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── Featured / Banners ────────────────────────────────────────────────────

    match /featured/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /banners/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── Submissions ─────────────────────────────────────────────────────────
    // Artist-contributor upload workflow. An artist creates submissions tied to
    // their uid and may read their own; admins read and moderate all. The
    // submitter cannot self-approve — only admins change `status`.

    match /submissions/{submissionId} {
      allow read: if isAdmin() || isOwner(resource.data.submittedBy);
      allow create: if isArtist()
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin()
        || (isOwner(resource.data.submittedBy)
            && resource.data.status == 'pending'
            && request.resource.data.status == 'pending'
            && request.resource.data.submittedBy == resource.data.submittedBy);
      allow delete: if isAdmin();
    }

    // ─── Song Requests ───────────────────────────────────────────────────────
    // Listeners ask for songs the catalog doesn't have (from Search or
    // Library). Any signed-in (non-anonymous) user may file one under their
    // own uid; only admins read them and move them out of "new".

    match /songRequests/{requestId} {
      // Listeners see their own requests (Profile) and can delete them
      // (account deletion); admins see and manage all.
      allow read, delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow create: if isSignedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.keys().hasOnly(['songTitle', 'artist', 'link',
             'details', 'searchQuery', 'userId', 'userName', 'userEmail',
             'status', 'createdAt'])
        && request.resource.data.songTitle is string
        && request.resource.data.songTitle.size() > 0
        && request.resource.data.songTitle.size() <= 150
        && request.resource.data.artist.size() <= 150
        && request.resource.data.link.size() <= 500
        && request.resource.data.details.size() <= 1000
        && request.resource.data.searchQuery.size() <= 200
        && request.resource.data.createdAt == request.time;
    }

    // ─── Audit Logs ──────────────────────────────────────────────────────────
    // Append-only moderation/audit trail. Readable by admins; entries are
    // written by the admin SDK (seed/import scripts) or by an admin client.
    // Never updatable or deletable from the client.

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ─── Home feed ───────────────────────────────────────────────────────────
    // Single pre-built doc (feeds/home) written by the aggregatePlays Cloud
    // Function. One public read replaces ~150–200 reads per Home open.

    match /feeds/{feedId} {
      allow read: if true;
      allow write: if false;
    }

    // ─── Play counting (server-only) ─────────────────────────────────────────
    // Plays go through the recordPlays callable (auth + quota). These buffers
    // are written and read only by the Admin SDK in Cloud Functions.

    match /playShards/{docId} { allow read, write: if false; }
    match /playBatches/{docId} { allow read, write: if false; }
    match /playQuotas/{docId} { allow read, write: if false; }
    match /dailyPlays/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
